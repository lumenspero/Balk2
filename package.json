{
  "name": "@lumenspero/balk2",
  "version": "2.0.1",
  "description": "Generate repository connection maps for AI-assisted code changes",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "balk2": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-schema.mjs",
    "prebuild": "node scripts/clean-tsup-leftovers.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:package": "npm run build && node scripts/run-package-tests.mjs",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run test:package",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "repository",
    "connection-map",
    "dependency-graph",
    "ai",
    "code-analysis",
    "static-analysis"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "typescript": "^5.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsup": "^8.3.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
